# Ultimate Project Manager runtime configuration
# Copy this file to .env, then run `npm run setup` or edit the values below.
# Never commit passwords, session secrets, encryption keys, or other real secrets.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
UPM_HOST=127.0.0.1
UPM_PORT=4310
UPM_BACKUP_ROOT=
UPM_RESTORE_ROOT=

# -----------------------------------------------------------------------------
# Remote access hardening
# -----------------------------------------------------------------------------
UPM_ALLOW_REMOTE_DASHBOARD=false
UPM_ALLOW_REMOTE_ADMIN=false
UPM_ALLOW_REMOTE_FILESYSTEM=false
UPM_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# HTTP hardening / limits
# -----------------------------------------------------------------------------
UPM_SECURITY_HEADERS=true
UPM_CSP=true
UPM_JSON_LIMIT=2mb
UPM_RATE_LIMIT_WINDOW_MS=60000
UPM_RATE_LIMIT_MAX=300
UPM_WRITE_RATE_LIMIT_MAX=60
UPM_REQUEST_TIMEOUT_MS=120000
UPM_HEADERS_TIMEOUT_MS=65000
UPM_KEEP_ALIVE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
UPM_AUTH_ENABLED=false
UPM_AUTH_USERNAME=admin
UPM_AUTH_PASSWORD_HASH=
UPM_SESSION_SECRET=
UPM_AUTH_SESSION_HOURS=12
UPM_AUTH_COOKIE_SECURE=false
UPM_AUTH_MAX_ATTEMPTS=5
UPM_AUTH_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Backup encryption
# -----------------------------------------------------------------------------
UPM_BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# LAN remote agents
# -----------------------------------------------------------------------------
UPM_LAN_AGENTS_JSON=
UPM_LAN_ALLOW_INSECURE_HTTP=false

# -----------------------------------------------------------------------------
# Local editor integration
# -----------------------------------------------------------------------------
UPM_EDITOR=vscode
UPM_EDITOR_COMMAND=
