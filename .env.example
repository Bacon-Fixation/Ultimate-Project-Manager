# Ultimate Project Manager v0.10.0
# Copy this file to .env, run `npm run setup` for the interactive wizard, or use Dashboard → More → Settings after the app is running. The application loads .env automatically.
# .env is the only project configuration file. UPM_* variables supplied by the parent shell/service are also supported and take priority over matching .env values.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
UPM_HOST=127.0.0.1
UPM_PORT=4310

# Optional absolute overrides. Leave blank to use data/backups and data/restores.
UPM_BACKUP_ROOT=
UPM_RESTORE_ROOT=

# -----------------------------------------------------------------------------
# Remote access hardening
# -----------------------------------------------------------------------------
# Remote access is opt-in. Keeping all three false is the safest configuration.
#
# Dashboard: allows remote clients to load read-only dashboard/API information.
UPM_ALLOW_REMOTE_DASHBOARD=false

# Admin: allows authenticated remote POST/PUT/DELETE operations such as backup,
# restore, dependency updates, File Tools runs, PM2 controls, and runtime settings.
# Authentication MUST be enabled when this is true.
UPM_ALLOW_REMOTE_ADMIN=false

# Filesystem: allows authenticated remote directory browsing, PM2 log reads,
# backup downloads, File Tools path access, and project source-vs-backup diff access.
# Authentication MUST be enabled when this is true. When false, remote read-only
# API responses redact local filesystem paths.
UPM_ALLOW_REMOTE_FILESYSTEM=false

# Only enable when the app is intentionally behind a reverse proxy on this same host.
# Forwarded client IP/protocol/host headers are trusted only from loopback proxy connections.
# Enable this for a same-machine reverse proxy so HTTPS/host origin checks use forwarded values.
UPM_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# HTTP hardening / limits
# -----------------------------------------------------------------------------
UPM_SECURITY_HEADERS=true
UPM_CSP=true
UPM_JSON_LIMIT=2mb
UPM_RATE_LIMIT_WINDOW_MS=60000
UPM_RATE_LIMIT_MAX=300
UPM_WRITE_RATE_LIMIT_MAX=60
UPM_REQUEST_TIMEOUT_MS=120000
UPM_HEADERS_TIMEOUT_MS=65000
UPM_KEEP_ALIVE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Recommended before enabling any remote dashboard access.
UPM_AUTH_ENABLED=false
UPM_AUTH_USERNAME=admin
# Generate with: npm run auth:hash -- "your strong password"
UPM_AUTH_PASSWORD_HASH=
# `npm run config:init` creates a 48-byte hex session secret automatically.
# Keep this value stable or existing sessions will be invalidated. The desktop launcher can repair
# a missing/invalid .env secret when authentication is enabled, but external overrides stay explicit.
UPM_SESSION_SECRET=
UPM_AUTH_SESSION_HOURS=12
# Set true ONLY when the browser reaches the dashboard over HTTPS (including a trusted HTTPS reverse proxy).
# For direct LAN access such as http://192.168.1.50:4310, keep this false. Browsers reject Secure cookies over plain HTTP.
UPM_AUTH_COOKIE_SECURE=false
UPM_AUTH_MAX_ATTEMPTS=5
UPM_AUTH_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Backup encryption
# -----------------------------------------------------------------------------
# Optional global passphrase used only by projects with encryption enabled.
# Generate a strong value with: npm run encryption:key
# Backups use AES-256-GCM with a per-archive random salt/IV and scrypt-derived keys.
# Keep the key stable and backed up securely: old encrypted archives require the same key.
UPM_BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Local editor integration
# -----------------------------------------------------------------------------
# vscode, vscode-insiders, cursor, windsurf, sublime, webstorm, or custom
UPM_EDITOR=vscode
# Used only for the custom editor selection. Set an executable path or command name.
UPM_EDITOR_COMMAND=

# -----------------------------------------------------------------------------
# LAN Remote Agents (controller / dashboard PC)
# -----------------------------------------------------------------------------
# Optional JSON array of authenticated UPM agents on other PCs in your LAN.
# Tokens are secrets: keep .env private and never commit it.
# Example (single line):
# HTTPS is required for non-loopback agents by default. Plain HTTP sends the bearer token unencrypted.
# Agent URLs must be origin-only (scheme + host + optional port), with no credentials, path, query, or fragment.
# Set UPM_LAN_ALLOW_INSECURE_HTTP=true only for a trusted LAN when HTTPS is not available.
UPM_LAN_ALLOW_INSECURE_HTTP=false
# UPM_LAN_AGENTS_JSON=[{"id":"workstation-2","name":"Workstation 2","url":"https://192.168.1.25:4311","token":"replace-with-64-char-random-token"}]
UPM_LAN_AGENTS_JSON=
