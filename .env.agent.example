# Ultimate Project Manager LAN Agent configuration
# Copy this file to .env.agent on the remote machine and customize it there.
# Never commit tokens or TLS private keys. Keep real credentials in .env.agent only.

# Listener. Use 127.0.0.1 for local-only access or 0.0.0.0 for a trusted LAN.
UPM_AGENT_HOST=0.0.0.0
UPM_AGENT_PORT=4311

# Optional stable identity shown to controllers. Blank values use the host name.
UPM_AGENT_ID=
UPM_AGENT_NAME=

# Required bearer token. Generate a strong random value of at least 32 characters.
UPM_AGENT_TOKEN=

# Local agent state and backup/restore locations. Blank values use UPM defaults.
UPM_AGENT_DATA_DIR=
UPM_AGENT_BACKUP_ROOT=
UPM_AGENT_RESTORE_ROOT=

# Required project allowlist for remote project operations.
# Separate multiple paths with semicolons, commas, or new lines.
UPM_AGENT_ALLOWED_PROJECT_ROOTS=

# Restrict backup and restore destinations to trusted roots.
UPM_AGENT_ALLOWED_BACKUP_ROOTS=
UPM_AGENT_ALLOWED_RESTORE_ROOTS=

# Optional controller IP allowlist. Blank permits authenticated controllers from any address.
UPM_AGENT_ALLOWED_CONTROLLER_IPS=

# Optional backup encryption key used by this agent.
UPM_AGENT_BACKUP_ENCRYPTION_KEY=

# Configure both paths to enable HTTPS. Leave both blank for HTTP on a trusted LAN.
UPM_AGENT_TLS_KEY_PATH=
UPM_AGENT_TLS_CERT_PATH=
