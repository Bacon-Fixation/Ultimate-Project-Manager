# Ultimate Project Manager LAN Agent
# Copy to .env.agent and keep the real file private. Never commit tokens or TLS private keys.

# Listener. Use a specific LAN address when possible instead of 0.0.0.0.
UPM_AGENT_HOST=0.0.0.0
UPM_AGENT_PORT=4311

# Required bearer token. Use at least 32 random characters; 64 random hex characters is recommended.
# Generate one with: npm run encryption:key
UPM_AGENT_TOKEN=

# Optional identity shown to controllers.
UPM_AGENT_ID=
UPM_AGENT_NAME=

# Required filesystem allow-lists. Separate multiple roots with semicolons, commas, or new lines.
# Keep these as narrow as practical; requests outside these roots are rejected.
UPM_AGENT_ALLOWED_PROJECT_ROOTS=
UPM_AGENT_ALLOWED_BACKUP_ROOTS=
UPM_AGENT_ALLOWED_RESTORE_ROOTS=

# Optional storage overrides. Defaults live under data/lan-agent.
UPM_AGENT_DATA_DIR=
UPM_AGENT_BACKUP_ROOT=
UPM_AGENT_RESTORE_ROOT=

# Optional controller IP allow-list. When set, requests from other source addresses are rejected.
UPM_AGENT_ALLOWED_CONTROLLER_IPS=

# Optional backup encryption key used by this agent.
UPM_AGENT_BACKUP_ENCRYPTION_KEY=

# Strongly recommended for non-loopback agents. Configure both files to enable HTTPS.
UPM_AGENT_TLS_KEY_PATH=
UPM_AGENT_TLS_CERT_PATH=
